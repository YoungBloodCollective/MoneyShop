{
  "expo": {
    "name": "MoneyShop",
    "slug": "moneyshop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "moneyshop",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "privacy": "public",
    "description": "MoneyShop - Platforma digitala de intermediere credite. Compara ofertele de la 10+ banci, verifica eligibilitatea si aplica online. Broker autorizat ANPC.",
    "githubUrl": "https://github.com/YoungBloodCollective/MoneyShop",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneyshop.mobile",
      "buildNumber": "1",
      "icon": "./assets/images/icon-ios.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "MoneyShop necesita acces la camera pentru verificarea identitatii (KYC) prin fotografierea actului de identitate.",
        "NSPhotoLibraryUsageDescription": "MoneyShop necesita acces la galeria foto pentru incarcarea documentelor necesare verificarii identitatii.",
        "NSFaceIDUsageDescription": "MoneyShop foloseste Face ID pentru autentificare rapida si sigura.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.moneyshop.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@tanstack/react-query"
          ]
        }
      }
    },
    "extra": {
      "privacyPolicyUrl": "https://moneyshop.ro/legal",
      "termsOfServiceUrl": "https://moneyshop.ro/legal"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
