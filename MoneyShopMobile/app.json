{
  "expo": {
    "name": "MoneyShop",
    "slug": "moneyshop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "moneyshop",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030303"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneyshop.mobile",
      "buildNumber": "1",
      "icon": "./assets/images/icon-ios.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Această aplicație are nevoie de acces la cameră pentru a încărca poze cu buletinul pentru verificare KYC.",
        "NSPhotoLibraryUsageDescription": "Această aplicație are nevoie de acces la galeria foto pentru a încărca poze cu buletinul pentru verificare KYC."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#030303"
      },
      "package": "com.moneyshop.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "build": {
        "babel": {
          "include": ["@tanstack/react-query"]
        }
      }
    }
  }
}
